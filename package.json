{
  "name": "mpsf",
  "version": "1.1.0",
  "description": "MPSF (My Personal Software Factory): contract-driven delivery, verified assessments, and visual project lineage for Codex and Claude Code.",
  "type": "module",
  "bin": {
    "agentic-sdlc": "./bin/agentic-sdlc.mjs",
    "mpsf": "./bin/mpsf.mjs"
  },
  "engines": {
    "node": "^18.20.3 || ^20.12.0 || >=21.6.0"
  },
  "files": [
    ".claude-plugin/",
    ".codex-plugin/plugin.json",
    "assets/",
    "bin/",
    "commands/",
    "config/",
    "docs/",
    "hooks/",
    "lib/",
    "schemas/",
    "scripts/",
    "skills/",
    "templates/",
    "ui/"
  ],
  "scripts": {
    "benchmark:enterprise": "node scripts/benchmark-enterprise-performance.mjs --enforce",
    "check": "node scripts/check-source-syntax.mjs",
    "release": "node scripts/release.mjs",
    "sync-version": "node scripts/sync-version.mjs && git add .claude-plugin .codex-plugin legacy",
    "doctor": "node bin/mpsf.mjs doctor",
    "smoke": "node bin/agentic-sdlc.mjs --help",
    "test": "node scripts/run-test-suite.mjs",
    "test:fast": "node scripts/run-test-suite.mjs --tier=fast",
    "test:enterprise": "npm test && npm run benchmark:enterprise"
  },
  "keywords": [
    "codex",
    "claude-code",
    "sdlc",
    "agentic",
    "knowledge-base",
    "observability",
    "explainability"
  ],
  "author": "Antonio Antenore",
  "license": "MIT",
  "homepage": "https://github.com/aantenore/mpsf#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aantenore/mpsf.git"
  },
  "bugs": {
    "url": "https://github.com/aantenore/mpsf/issues"
  }
}
