{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "known-error.schema.json",
  "title": "Agentic SDLC Known Error v1",
  "description": "A recurring problem with a reusable diagnosis and fix, keyed by a deterministic failure signature. Immutable: how it is used, accepted or retired is recorded as events under known-errors/events/<id>/.",
  "type": "object",
  "required": ["kind", "schema_version", "id", "title", "signature", "diagnosis", "steps", "fix", "scope", "created_by", "created_at", "record_hash", "hash_algorithm"],
  "properties": {
    "kind": { "const": "known_error" },
    "schema_version": { "const": "known-error:v1" },
    "id": { "type": "string", "pattern": "^KE-[0-9a-f]{12}$" },
    "title": { "type": "string", "minLength": 1 },
    "signature": {
      "type": "object",
      "required": ["version", "key", "check", "command", "exit_code", "message", "path"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "check": { "type": ["string", "null"] },
        "command": { "type": ["string", "null"] },
        "exit_code": { "type": ["integer", "null"] },
        "message": { "type": "string" },
        "path": { "type": ["string", "null"] },
        "aliases": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
      }
    },
    "diagnosis": { "type": "string", "minLength": 1 },
    "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "fix": {
      "type": "object",
      "required": ["safe", "actions"],
      "properties": {
        "safe": { "type": "boolean" },
        "actions": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "object", "required": ["type", "path"], "properties": { "type": { "const": "remove_path" }, "path": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
              { "type": "object", "required": ["type", "pattern"], "properties": { "type": { "const": "gitignore_add" }, "pattern": { "type": "string", "minLength": 1 } }, "additionalProperties": false }
            ]
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "repo": { "type": ["string", "null"] },
        "plugin_versions": {
          "type": "object",
          "properties": { "min": { "type": ["string", "null"] }, "max": { "type": ["string", "null"] } }
        }
      }
    },
    "seen_in": { "type": ["object", "null"] },
    "created_by": { "type": "object" },
    "created_at": { "type": "string", "minLength": 1 },
    "git": { "type": ["object", "null"] },
    "record_hash": { "type": "string" },
    "hash_algorithm": { "type": "string" }
  }
}
